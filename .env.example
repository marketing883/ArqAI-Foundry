# ArqAI Foundry - Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://arqai:arqai_secret@localhost:5432/arqai_foundry

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# HashiCorp Vault
# =============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_NAMESPACE=

# =============================================================================
# Identity & Security
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CAPABILITY_TOKEN_TTL_SECONDS=300

# =============================================================================
# LLM Providers (Add your API keys)
# =============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Anthropic
ANTHROPIC_API_KEY=

# Google AI
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cohere
COHERE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# =============================================================================
# Integrations
# =============================================================================
# AWS (for cost optimization)
AWS_ROLE_ARN=

# Jira
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# Microsoft Teams
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_WEBHOOK_URL=

# =============================================================================
# Evidence & Compliance
# =============================================================================
EVIDENCE_RETENTION_DAYS=2555
EVIDENCE_ENCRYPTION_KEY=

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=50
